.grubhub_env
.env
.worktrees/

# Generated fresh by deploy.sh right before every `railway up` — backs
# GET /api/v1/debug/version, since `railway up` (a local-directory
# upload, not a GitHub-connected deploy) doesn't populate
# RAILWAY_GIT_COMMIT_SHA or carry .git into the container.
backend/GIT_COMMIT.txt