app.db

# Backend runtime cache — currently ~49k files (rendered JS bundles for
# menu-scraping browser fallback), regenerated automatically, never meant
# to be committed. Previously ungitignored, so a `git status`/`git add .`
# would pick up tens of thousands of cache files.
backend/app/data/cache/

# Node / frontend
node_modules/
dist/
build/
.expo/
.next/

# OS
.DS_Store

# Logs
*.log

# IDE
.vscode/
.idea/

# Misc
*.lock
# Grubhub local credentials (NEVER commit)
.grubhub_env
.env
.worktrees/

# NOTE: backend/GIT_COMMIT.txt (generated fresh by deploy.sh right before
# every `railway up`, backing GET /api/v1/debug/version) is deliberately
# NOT listed here. `railway up` respects .gitignore when deciding what to
# upload — gitignoring this file would silently exclude it from the very
# deploy it's meant to verify (confirmed live: this was tried, and
# /version kept coming back null even after a successful deploy).
# deploy.sh creates it right before `railway up` and deletes it right
# after, so it never lingers as an untracked file between deploys.