# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored — never commit it.
#
# Every var here MUST be prefixed EXPO_PUBLIC_ to be readable from app code,
# which also means every value is compiled into the shipped app bundle and is
# readable by anyone who unzips the APK/IPA. Nothing here is a secret — put
# real secrets in Railway's environment variables (backend-side) only.

# Backend API base URL.
# Get from: Railway dashboard -> your CRAVE service -> Settings -> Networking
#           -> Public Domain (looks like https://crave-production-xxxx.up.railway.app)
#
# IMPORTANT: if this is unset, src/api/client.ts falls back to
# http://localhost:8000 — which on a physical phone means "the phone itself",
# so every API call fails silently with a network error. Set it before testing
# on a device.
#
# Testing against a backend running on your own computer instead? Use your
# computer's LAN IP, never localhost — e.g. http://192.168.1.42:8000
# (find it with `ipconfig getifaddr en0` on macOS, `hostname -I` on Linux),
# and start uvicorn with --host 0.0.0.0 so it accepts connections from the phone.
EXPO_PUBLIC_API_URL=

# Backend API key — must match the API_KEY value set in Railway.
EXPO_PUBLIC_API_KEY=

# Supabase (used for Google/Apple sign-in).
# Get both from: Supabase dashboard -> your project -> Project Settings -> API
#   URL      -> "Project URL"
#   ANON KEY -> "anon" / "public" key (NOT the service_role key — that one is
#               backend-only and must never ship in the app bundle)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps — Android only (see app.config.js for why iOS doesn't need
# one). Without this, the map screen renders as a blank gray box on
# Android specifically — nothing crashes, there's just no map.
# Get it from: Google Cloud Console -> APIs & Services -> Credentials.
# Restrict it to Android apps (package com.crave.app + your signing
# SHA-1 fingerprint) — this key ships inside the compiled app, so API
# allowlisting alone isn't enough to keep it from being reused elsewhere.
GOOGLE_MAPS_ANDROID_API_KEY=
