{
  "expo": {
    "name": "CRAVE",
    "slug": "crave",
    "version": "1.0.0",
    "scheme": "crave",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crave.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.crave.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CRAVE uses your location to show nearby restaurants and personalize the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CRAVE needs access to your photos so you can share pictures of food and menus with a place."
        }
      ]
    ]
  }
}
